# Tavily Search API Key (Used by War Scout)
TAVILY_API_KEY=tvly-...

# OpenAI API Key (Used by Agents)
OPENAI_API_KEY=sk-...

# Anthropic API Key (Used by Agents - Claude)
ANTHROPIC_API_KEY=sk-ant-...

# LLM Configuration
PRIMARY_MODEL=openai/gpt-4o
FALLBACK_MODEL=anthropic/claude-haiku-4-5
MAX_TOKENS=4000

# Environment settings
ENV=development
